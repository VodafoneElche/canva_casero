// Recursos de Windows: icono del programa y datos de versión
#include <winver.h>

GLFW_ICON ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     0,7,0,0
PRODUCTVERSION  0,7,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "FileDescription", "Lienzo Casero - programa de diseño para casa"
            VALUE "FileVersion", "0.7.0"
            VALUE "ProductName", "Lienzo Casero"
            VALUE "ProductVersion", "0.7.0"
            VALUE "OriginalFilename", "LienzoCasero.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
